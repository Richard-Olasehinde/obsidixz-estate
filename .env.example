# ============================================================================
# Obsidixz Real Estate — environment configuration (EXAMPLE ONLY)
# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or any real credential. See ENVIRONMENT_SETUP.md.
# ============================================================================

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# The public address of the deployed website. Used for canonical URLs,
# Open Graph URLs, the sitemap and robots.txt.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://realestate.obsidixz.pp.ua

# ---------------------------------------------------------------------------
# Enquiries
# ---------------------------------------------------------------------------
# There is no enquiry form, no sending service and no server-side endpoint.
# A website visitor's own email application sends the message directly to the
# business mailbox below, and replies are sent from that mailbox.
#
# Nothing needs configuring for this to work, and nothing here is a credential.
# The address is a public contact detail, not a secret.

# ---------------------------------------------------------------------------
# Optional public business contact details
# ---------------------------------------------------------------------------
# CONFIRMED 2026-11-06: the official business mailbox. It is also the hardcoded
# fallback in src/lib/site.ts, so the published site always shows a working
# address even if this variable is unset. Setting it here overrides.
#
# This address is published deliberately: it is the contact route the whole
# website points at. It is a Microsoft Outlook mailbox that the business
# monitors and replies from.
NEXT_PUBLIC_BUSINESS_EMAIL=obsidixz.realestate@outlook.com

# NOT confirmed. Left blank deliberately — do not guess a number. When blank,
# the site shows no telephone and does not fabricate one.
NEXT_PUBLIC_BUSINESS_PHONE=
