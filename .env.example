# ============================================================================
# Obsidixz Real Estate — environment configuration (EXAMPLE ONLY)
# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or any real credential. See ENVIRONMENT_SETUP.md.
# ============================================================================

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# The public address of the deployed website. Used for canonical URLs,
# Open Graph URLs, the sitemap and robots.txt.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://realestate.obsidixz.pp.ua

# ---------------------------------------------------------------------------
# Enquiry form delivery
# ---------------------------------------------------------------------------
# The contact form only reports success when the configured destination
# genuinely accepts the submission. Until a destination is configured the form
# returns a clear "submission not available" state and no enquiry is lost
# silently.
#
# ENQUIRY_DELIVERY_MODE options:
#   unconfigured : default. The form is validated but delivery is disabled.
#   webhook      : POST submissions as JSON to ENQUIRY_WEBHOOK_URL.
#   console      : development only. Prints submissions to the server log.
#                  Refused in production builds.
ENQUIRY_DELIVERY_MODE=unconfigured

# A destination that accepts an HTTP POST with a JSON body and returns 2xx.
# Examples: Formspree (https://formspree.io/f/XXXX), Formspark, Make, Zapier,
# n8n, a serverless function, or your own CRM endpoint.
# Do not guess or invent an endpoint: create the destination first.
ENQUIRY_WEBHOOK_URL=

# Optional. If your destination requires authentication, supply a bearer
# token. Leave empty if the destination does not require one.
# This value is server-side only and is never sent to the browser.
ENQUIRY_WEBHOOK_TOKEN=

# Optional timeout for the delivery request, in milliseconds. Default 10000.
ENQUIRY_WEBHOOK_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Enquiry form protection (server-side, in-memory)
# ---------------------------------------------------------------------------
# Maximum submissions accepted per IP address within the window below.
ENQUIRY_RATE_LIMIT_MAX=5
# Window length in minutes.
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=60

# ---------------------------------------------------------------------------
# Optional public business contact details
# ---------------------------------------------------------------------------
# These are NOT invented here. Leave blank until the founder confirms the real
# business mailbox / phone number. When blank, the website shows the enquiry
# form as the contact route and marks the direct email as pending setup.
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
